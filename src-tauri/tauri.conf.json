{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Manager",
  "version": "0.2.2",
  "identifier": "cc.codex.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Manager",
        "width": 1440,
        "height": 960,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "本地优先的 Codex 使用与 AGENTS 管理器",
    "longDescription": "在本机观察 Codex 模型调用元数据、token、耗时和 API 等价价格，并安全管理项目 AGENTS 文件。",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMUI4MkUxQkJCQkZCOEMKUldTTSs3dTc0WUlid002a1NvWHZ1ZlR1Ynl3YUhnOUlJMS8rYUNsMnU2SmdjbWtEcjdDQVRua2UK",
      "endpoints": [
        "https://github.com/ewsun22/codex-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
