{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "仅允许主窗口调用本地 Rust 命令；前端没有任意文件或 Shell 权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "allow-bootstrap",
    "allow-get-dashboard",
    "allow-list-activity",
    "allow-get-activity-facets",
    "allow-list-projects",
    "allow-discover-projects",
    "allow-get-agents-chain",
    "allow-open-agents-file",
    "allow-create-agents-file",
    "allow-save-agents-file",
    "allow-list-agents-revisions",
    "allow-restore-agents-revision",
    "allow-list-sources",
    "allow-list-pricing-rules",
    "allow-get-settings",
    "allow-get-otel-config",
    "allow-update-settings",
    "allow-rescan",
    "allow-probe-codex",
    "allow-check-for-update",
    "allow-install-pending-update",
    "allow-get-codex-account",
    "allow-start-codex-login",
    "allow-list-auth-profiles",
    "allow-import-auth-profile",
    "allow-activate-auth-profile",
    "allow-delete-auth-profile",
    "allow-restore-auth-profile",
    "allow-get-codex-config-snapshot",
    "allow-save-codex-config-profile",
    "allow-delete-codex-config-profile",
    "allow-preview-codex-config-profile",
    "allow-apply-codex-config-profile",
    "allow-restore-codex-config",
    "allow-list-proxy-auth-profiles",
    "allow-import-proxy-auth-profile",
    "allow-set-proxy-auth-profile-enabled",
    "allow-delete-proxy-auth-profile",
    "allow-restore-proxy-auth-profile",
    "allow-list-codex-providers",
    "allow-save-codex-provider",
    "allow-delete-codex-provider",
    "allow-get-codex-gateway-status",
    "allow-check-latest-cliproxy-core",
    "allow-install-latest-cliproxy-core",
    "allow-update-codex-gateway-port",
    "allow-start-codex-gateway",
    "allow-stop-codex-gateway"
  ]
}
